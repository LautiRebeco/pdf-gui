# ---------------------------------------------------------------------------
# Configuración de la GUI (todas las variables se leen del entorno al arrancar)
# Poly-repo con Traefik: un único entrypoint con routing por path.
# ---------------------------------------------------------------------------

# Entrypoint de Traefik (TLS terminado en el gateway)
PDF_EXTRACT_GATEWAY_URL=https://gateway.local

# Defaults derivados del gateway: ${PDF_EXTRACT_GATEWAY_URL}/documents y /extract.
# Solo hace falta definirlos si Traefik enruta por Host en lugar de por path,
# o si se quiere hablar directo con un servicio (modo desarrollo).
# PDF_EXTRACT_DOCUMENTS_URL=https://documentos.local
# PDF_EXTRACT_EXTRACT_URL=https://extraccion.local

# Alias backwards-compatible (se ignoran si las variables canónicas están seteadas)
# API_URL=http://127.0.0.1:8080
# DOCUMENTS_API_URL=http://127.0.0.1:8080/documents
# EXTRACT_API_URL=http://127.0.0.1:8080/extract

# Autenticación en Traefik (Basic o Bearer). Nunca se guarda en disco.
# PDF_EXTRACT_AUTH_TOKEN=change-me
# PDF_EXTRACT_AUTH_SCHEME=Bearer
# PDF_EXTRACT_BASIC_USER=gui
# PDF_EXTRACT_BASIC_PASSWORD=change-me
# PDF_EXTRACT_AUTH_HEADER=Authorization
# PDF_EXTRACT_AUTH_VALUE="Basic base64..."

# TLS: CA interna del gateway (verificación SIEMPRE activa)
# PDF_EXTRACT_CA_BUNDLE=/etc/ssl/certs/traefik-internal-ca.pem

# Red / resiliencia
PDF_EXTRACT_CONNECT_TIMEOUT=5
PDF_EXTRACT_READ_TIMEOUT=120
PDF_EXTRACT_MAX_RESPONSE_BYTES=20971520
PDF_EXTRACT_MAX_PDF_BYTES=10485760
PDF_EXTRACT_RETRY_ATTEMPTS=3
PDF_EXTRACT_RETRY_BASE_DELAY=0.5
PDF_EXTRACT_RETRY_MAX_DELAY=5
PDF_EXTRACT_SAGA_ENABLED=true
PDF_EXTRACT_SAGA_POLL_INTERVAL=1
PDF_EXTRACT_SAGA_TIMEOUT=180
PDF_EXTRACT_ALLOW_REDIRECTS=false
PDF_EXTRACT_TRUST_ENV=false
PDF_EXTRACT_MAX_WORKERS=4

# UI / observabilidad
PDF_EXTRACT_THEME=dark
PDF_EXTRACT_LOG_LEVEL=INFO
# PDF_EXTRACT_LOG_FILE=/var/log/pdf-extractext-gui/app.log
PDF_EXTRACT_HEALTH_HOST=127.0.0.1
PDF_EXTRACT_HEALTH_PORT=0
PDF_EXTRACT_VERSION=0.1.0
